# Copy to backend/.env (gitignored) and fill in. Never commit real keys.

# Large model: OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=xhigh
OPENAI_MAX_OUTPUT_TOKENS=32000
# OPENAI_BASE_URL=https://api.openai.com/v1

# Small model: local Qwen behind an OpenAI-compatible /chat/completions endpoint
# Ollama: http://127.0.0.1:11434/v1   LM Studio: http://127.0.0.1:1234/v1   mlx_lm.server: http://127.0.0.1:8080/v1
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3.8:27b-mlx
# none | json_object | json_schema. Ollama + qwen3.8:27b-mlx returns 501 for structured output, so none.
QWEN_RESPONSE_FORMAT=none
QWEN_MAX_OUTPUT_TOKENS=8192
# Ollama maps this to thinking on/off; none = no thinking (fast, predictable latency)
QWEN_REASONING_EFFORT=none
# QWEN_TEMPERATURE=0.2
# QWEN_API_KEY=

# Hosted alternative (AIPing): replace the local settings above and set QWEN_API_KEY.
# QWEN_BASE_URL=https://aiping.cn/api/v1
# QWEN_MODEL=Qwen3.8-27B
# QWEN_RESPONSE_FORMAT=json_object
# QWEN_REASONING_EFFORT=
# QWEN_ENABLE_THINKING=false

# --action-router decisions / --model-router decisions use OPENAI_API_KEY with
# gpt-6-luna at the official Decisions endpoint, independent of OPENAI_MODEL.
